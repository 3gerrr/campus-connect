{
  "expo": {
    "name": "Campus Connect",
    "slug": "campus-connect",
    "version": "0.1.0",
    "orientation": "portrait",
    "plugins": [
      "expo-camera",
      "expo-local-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E4002B"
        }
      ],
      "expo-splash-screen"
    ],
    "splash": {
      "backgroundColor": "#ffffff",
      "resizeMode": "contain"
    },
    "ios": {
      "bundleIdentifier": "com.yourorg.campusconnect",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Use Face ID to quickly and securely log in.",
        "NSCameraUsageDescription": "Used to capture verification documents for representative approval."
      }
    },
    "android": {
      "package": "com.yourorg.campusconnect",
      "permissions": [
        "CAMERA",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "a5f85029-de5c-42d3-87a8-eb2f461e2762"
      }
    },
    "owner": "3gerr"
  }
}
